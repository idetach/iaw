# --- Execution safety -------------------------------------------------------
# shadow = log intended trades only | demo = Bybit demo trading | live = real
EXECUTION_MODE=demo
# Master enable for the loop. false = no new entries (open positions still managed).
LOOP_ENABLED=true

# --- Storage ----------------------------------------------------------------
# Same bucket as the manual vision pipeline; separate prefix keeps the
# autonomous stream cleanly separable (manual uses "cases").
GCS_BUCKET=iaw_charts
GOOGLE_APPLICATION_CREDENTIALS=
CASES_PREFIX=cases-auto
PERSIST_CASES=true

# Append recent closed-trade outcomes for the symbol to the Opus synthesis
# prompt. OFF by default — this is LLM memory, distinct from the code-level
# cooldown rule, and may bias decisions; enable as a measured experiment.
INCLUDE_RECENT_OUTCOMES=false

# --- Upstream services ------------------------------------------------------
BYBIT_TRADING_URL=http://localhost:8081
BYBIT_TRADING_TOKEN=
BYBIT_TRADING_TIMEOUT=30.0
AGENT_TRADING_URL=http://localhost:8082

# --- Models (ADR-0004/0005: cost tiers by call volume x stakes) -------------
# gate: every candidate, every tick (highest volume, binary verdict) -> cheap
# synthesis: only gate survivors (rare, high stakes) -> strong
# reflection: only closed trades (rare, compounds into memory) -> strong
# Options: claude-fable-5 | claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
MODEL_GATE=claude-sonnet-5
MODEL_SYNTHESIS=claude-opus-5
MODEL_REFLECTION=claude-opus-5

# --- Watchlist / candidates -------------------------------------------------
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
RADAR_ENABLED=true
MAX_CANDIDATES_PER_TICK=6

# --- Indicator engine -------------------------------------------------------
TIMEFRAMES=4h,1h,30m,15m
KLINE_LIMIT=200

# --- Risk governor (risk-governor-spec) -------------------------------------
RISK_FRACTION=0.0075              # 0.75% of equity risked per trade
MAX_CONCURRENT_POSITIONS=4
MAX_TOTAL_MARGIN_FRACTION=0.40
MAX_AGGREGATE_OPEN_RISK=0.03
MAX_LEVERAGE=10
MAX_MARGIN_PERCENT=25
SYMBOL_COOLDOWN_HOURS=4
# Resting entry orders: cancel when older than TTL, when the reconcile-TF
# trend flips against them, or when price drifts > N ATRs from the limit.
ORDER_TTL_MINUTES=120
ORDER_MAX_DRIFT_ATR=2.0
ORDER_RECONCILE_TIMEFRAME=1h
DAILY_LOSS_BREAKER_FRACTION=0.03
WEEKLY_LOSS_BREAKER_FRACTION=0.06
MIN_CONFIDENCE=0.6

# --- Server -----------------------------------------------------------------
PORT=8084
FRONTEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
