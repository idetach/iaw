POSTGRES_DB=metrics_margin
POSTGRES_USER=metrics_margin
POSTGRES_PASSWORD=metrics_margin
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin





# Leave empty to auto-discover all USDT margin pairs from Binance.
# Set to a comma-separated list to track only specific pairs.
TRACKED_ASSETS=
TRACKED_SYMBOLS=

PRICE_POLL_SECONDS=300
INVENTORY_POLL_SECONDS=300
CONFIG_POLL_SECONDS=3600
BACKFILL_HOURS=168
PRICE_KLINE_INTERVAL=5m
# Wait for candle close before fetching (aligns with TradingView / exchange charts)
ALIGN_TO_CANDLE_CLOSE=true
# Seconds after candle close to fetch (10s gives Binance time to finalize the kline)
FETCH_OFFSET_SECONDS=10
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=4
RETRY_BACKOFF_SECONDS=1.5
LOG_LEVEL=INFO
APP_NAME=metrics_margin



